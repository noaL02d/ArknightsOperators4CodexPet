{
  "name": "arknights-operators-4-codex-pet",
  "version": "0.1.0",
  "private": true,
  "description": "Arknights operator desktop pet that follows the Codex desktop app",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fetch-asset": "node scripts/fetch-asset.mjs",
    "install:codex-pet": "node scripts/build.mjs && electron . --export-native-pet",
    "dist": "node scripts/build.mjs && electron-builder --win portable"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.noal02d.arknights-operators-codex-pet",
    "productName": "ArknightsOperators4CodexPet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "ArknightsOperators4CodexPet-${version}.exe"
    }
  }
}
